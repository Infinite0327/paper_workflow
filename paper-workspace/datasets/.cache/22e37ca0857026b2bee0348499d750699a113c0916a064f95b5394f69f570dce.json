ta:20050401", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.1109/ACC.2007.4282726", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.1137/S009753979628292X", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "https://www.mit.edu/~jnt/Papers/PhD-84-jnt.pdf", "relatedIdentifierType": "URL"}, {"relationType": "Cites", "relatedIdentifier": "10.1109/TAC.1986.1104412", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.1016/j.sysconle.2004.02.022", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10/bmq2t4", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.1109/IPSN.2005.1440896", "relatedIdentifierType": "DOI"}], "relatedItems": [{"volume": "221", "relationType": "IsPublishedIn", "relatedItemIdentifier": {"relatedItemIdentifier": "10.4230/LIPIcs.SAND.2022", "relatedItemIdentifierType": "DOI"}, "number": "10", "lastPage": "10:16", "firstPage": "10:1", "relatedItemType": "ConferenceProceeding", "publisher": "Schloss Dagstuhl – Leibniz-Zentrum für Informatik", "publicationYear": "2022", "titles": [{"title": "LIPIcs, Volume 221, SAND 2022"}, {"titleType": "Subtitle", "title": "1st Symposium on Algorithmic Foundations of Dynamic Networks (SAND 2022)"}], "contributors": [{"nameType": "Personal", "givenName": "James", "familyName": "Aspnes", "name": "Aspnes, James", "contributorType": "Editor"}, {"nameType": "Personal", "givenName": "Othon", "familyName": "Michail", "name": "Michail, Othon", "contributorType": "Editor"}]}, {"volume": "221", "relationType": "IsPublishedIn", "relatedItemIdentifier": {"relatedItemIdentifier": "1868-8969", "relatedItemIdentifierType": "ISSN"}, "relatedItemType": "Collection", "publisher": "Schloss Dagstuhl – Leibniz-Zentrum für Informatik", "publicationYear": "2022", "titles": [{"title": "Leibniz International Proceedings in Informatics (LIPIcs)"}]}], "sizes": ["16 pages", "878580 bytes"], "formats": ["application/pdf"], "version": null, "rightsList": [{"rightsUri": "https://creativecommons.org/licenses/by/4.0/legalcode", "rights": "Creative Commons Attribution 4.0 International license", "lang": "en", "rightsIdentifier": "cc by 4.0"}, {"rights": "info:eu-repo/semantics/openAccess"}], "descriptions": [{"descriptionType": "Abstract", "description": "Networked systems of autonomous agents, and applications thereof, often rely on the control primitive of average consensus, where the agents are to compute the average of private initial values. To provide reliable services that are easy to deploy, average consensus should continue to operate when the network is subject to frequent and unpredictable change, and should mobilize few computational resources, so that deterministic, low powered, and anonymous agents can partake in the network.\r\nIn this stringent adversarial context, we investigate the implementation of average consensus by distributed algorithms over networks with bidirectional, but potentially short-lived, communication links. Inspired by convex recurrence rules for multi-agent systems, and the Metropolis average consensus rule in particular, we design a deterministic distributed algorithm that achieves asymptotic average consensus, which we show to operate in polynomial time in a synchronous temporal model.\r\nThe algorithm is easy to implement, has low space and computational complexity, and is fully distributed, requiring neither symmetry-breaking devices like unique identifiers, nor global control or knowledge of the network. In the fully decentralized model that we adopt, to our knowledge, no other distributed average consensus algorithm has a better temporal complexity.\r\nOur approach distinguishes itself from classical convex recurrence rules in that the agent’s values may sometimes leave their previous convex hull. As a consequence, our convergence bound requires a subtle analysis, despite the syntactic simplicity of our algorithm.", "lang": "en"}, {"descriptionType": "SeriesInformation", "description": "LIPIcs, Vol. 221, 1st Symposium on Algorithmic Foundations of Dynamic Networks (SAND 2022), pages 10:1-10:16", "lang": "en"}], "geoLocations": [], "fundingReferences": [], "url": "https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.SAND.2022.10", "contentUrl": null, "metadataVersion": 1, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "api", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "downloadCount": 0, "referenceCount": 0, "citationCount": 0, "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2022-04-29T05:47:40Z", "registered": "2022-04-29T05:47:42Z", "published": null, "updated": "2023-12-21T15:35:41Z"}, "relationships": {"client": {"data": {"id": "lzi.drops", "type": "clients"}}}}], "meta": {"total": 5, "totalPages": 1, "page": 1}, "links": {"self": "https://api.datacite.org/dois?query=relatedIdentifiers.relatedIdentifier%3A10.1109%2Ftac.2003.812781&page%5Bsize%5D=25"}}