 "https://orcid.org/0000-0002-6234-3960"}], "contributorType": "Editor"}], "dates": [{"date": "2022", "dateType": "Issued"}, {"date": "2022-04-29", "dateType": "Available"}, {"date": "2022-04-29", "dateType": "Created"}, {"date": "2022-04-29", "dateType": "Copyrighted"}], "language": "en", "types": {"schemaOrg": "Article", "resourceTypeGeneral": "ConferencePaper", "citeproc": "", "bibtex": "inproceedings", "ris": "CPAPER"}, "relatedIdentifiers": [{"relationType": "IsVersionOf", "resourceTypeGeneral": "Text", "relatedIdentifier": "arXiv:2010.05675", "relatedIdentifierType": "arXiv"}, {"relationType": "IsPartOf", "relatedIdentifier": "10.4230/LIPIcs.SAND.2022", "relatedIdentifierType": "DOI"}, {"relationType": "IsPartOf", "relatedIdentifier": "978-3-95977-224-2", "relatedIdentifierType": "ISBN"}, {"relationType": "IsPartOf", "relatedIdentifier": "1868-8969", "relatedIdentifierType": "ISSN"}, {"relationType": "Cites", "relatedIdentifier": "10.1145/800141.804655", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.1007/3-540-45414-4_3", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.1109/ISIT.2010.5513273", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.1109/TCNS.2015.2428411", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "arXiv:2007.04837", "relatedIdentifierType": "arXiv"}, {"relationType": "Cites", "relatedIdentifier": "10.1109/CDC.2018.8619817", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.2307/3213262", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.1016/0743-7315(89)90021-X", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.1007/978-3-030-91081-5_28", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedIdentifier": "10.2307/2285509", "relatedIdentifierType": "DOI"}, {"relationType": "Cites", "relatedI