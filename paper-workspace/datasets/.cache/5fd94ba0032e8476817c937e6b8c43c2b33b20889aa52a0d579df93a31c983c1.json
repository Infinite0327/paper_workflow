atedIdentifier": "10.1007/3-540-50701-9\\_16", "relatedIdentifierType": "DOI"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "urn:nbn:de:0074-2445-7", "relatedIdentifierType": "URN"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "10.1007/978-94-009-2865-7_6", "relatedIdentifierType": "DOI"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "10.24963/kr.2020/47", "relatedIdentifierType": "DOI"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "10.24963/kr.2020/56", "relatedIdentifierType": "DOI"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "10.1007/978-3-030-75775-5_7", "relatedIdentifierType": "DOI"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "https://ojs.aaai.org/index.php/AAAI/article/view/16808", "relatedIdentifierType": "URL"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "10.1007/978-1-4684-2001-2_9", "relatedIdentifierType": "DOI"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "10.24963/ijcai.2021/711", "relatedIdentifierType": "DOI"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "10.5555/645874.758296", "relatedIdentifierType": "DOI"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "10.1007/978-3-319-30024-5\\_4", "relatedIdentifierType": "DOI"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "http://www.aaai.org/Library/KR/2006/kr06-025.php", "relatedIdentifierType": "URL"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "http://ceur-ws.org/Vol-2961/paper\\_4.pdf", "relatedIdentifierType": "URL"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "https://nmr.cs.tu-dortmund.de/proceedings/NMR2021Proceedings.pdf", "relatedIdentifierType": "URL"}, {"relationType": "References", "resourceTypeGeneral": "ConferencePaper", "relatedIdentifier": "10.1007/978-3-030-19570-0\\_18", "relatedIdentifierType": "DOI"}, {"relationType": "References", "resourceTypeGeneral": "Software", "relatedIdentifier": "10.5281/zenodo.5544135", "relatedIdentifierType": "DOI"}, {"relationType": "HasVersion", "relatedIdentifier": "10.5281/zenodo.7274824", "relatedIdentifierType": "DOI"}], "relatedItems": [], "sizes": [], "formats": [], "version": "2", "rightsList": [{"rightsIdentifierScheme": "SPDX", "rightsUri": "https://creativecommons.org/licenses/by/4.0/legalcode", "schemeUri": "https://spdx.org/licenses/", "rights": "Creative Commons Attribution 4.0 International", "rightsIdentifier": "cc-by-4.0"}, {"rightsUri": "info:eu-repo/semantics/openAccess", "rights": "Open Access"}], "descriptions": [{"descriptionType": "Abstract", "description": "In the context of knowledge representation and reasoning, the consideration of relevance plays a major role. The concept of syntax splitting has received an increasing amount of attention in recent years and has been investigated together with other contemporary methods. Originally formulated with respect to belief revision of belief sets, in 2017 Kern-Isberner and Brewka introduced the notion of<br> syntax splitting for total preorders, and in 2020 KernIsberner et al. provided a basic notion of syntax splitting of conditional knowledge bases within the setting of non-monotonic reasoning. The work presented in this thesis extends the Java library InfOCF-Lib by the possibility to read and represent total preorders and to compute syntax splittings of epistemic states represented by total preorders as well as the unique finest syntax splitting of conditional knowledge bases in an automated way. For this purpose, the concept of splittability is introduced, which enables the calculation of syntax splittings for total preorders to be modelled and solved as a modified subset-sum problem. Moreover, with Makinson’s notion of epistemic relevance, it is possible to calculate syntax splittings for conditional knowledge bases by considering the conditionals as epistemic knowledge that must not be split. This connection can be recognised and calculated by the transitive closure of the atoms in the conditionals. Based on these concepts, suitable algorithms are developed, implemented in InfOCF-Lib, and then evaluated whether concurrent processing brings a runtime advantage. To calculate syntax splittings for ranking functions, a basic approach is provided to model and solve this as a subset-sum problem as well."}], "geoLocations": [], "fundingReferences": [], "url": "https://zenodo.org/record/7274823", "contentUrl": null, "metadataVersion": 0, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "downloadCount": 0, "referenceCount": 0, "citationCount": 0, "partCount": 0, "partOfCount": 0, "versionCount": 1, "versionOfCount": 0, "created": "2022-11-02T19:50:15Z", "registered": "2022-11-02T19:50:15Z", "published": null, "updated": "2022-11-02T19:50:15Z"}, "relationships": {"client": {"data": {"id": "cern.zenodo", "type": "clients"}}}}], "meta": {"total": 2, "totalPages": 1, "page": 1}, "links": {"self": "https://api.datacite.org/dois?query=relatedIdentifiers.relatedIdentifier%3A10.1017%2Fs0269888900008122&page%5Bsize%5D=25"}}